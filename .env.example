# FixtureLog environment variables
# Copy to .env and fill in values

# Neon Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Production app URL — used by server components to build absolute fetch URLs to API routes.
# In production this MUST be the deployed origin (e.g. https://fixturelog.manumustudio.com);
# locally it can be omitted (falls back to http://localhost:3000).
NEXT_PUBLIC_APP_URL="https://fixturelog.manumustudio.com"

# ─────────────────────────────────────────────────────────────────────────────
# Auth.js / ManuMuStudio OAuth client (PACKET-008)
# Server-only secrets — never exposed to the client bundle (see src/lib/env.server.ts).
# NEXTAUTH_URL, APP_URL, and NEXT_PUBLIC_APP_URL must resolve to the SAME origin per env.
# AUTH_ISSUER_URL has no trailing slash here; Auth.js appends "/" for the issuer.
# AUTH_CLIENT_ID / AUTH_CLIENT_SECRET are printed once by the auth-server seed script:
#   pnpm tsx scripts/seed-fixturelog-client.ts   (run in m2-next-auth-prisma-postgres-starter)
# ─────────────────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="local-dev-nextauth-secret-32-chars-minimum"
APP_URL="http://localhost:3000"
AUTH_ISSUER_URL="https://auth.manumustudio.com"
AUTH_CLIENT_ID="fixturelog-client-id-from-auth-server"
AUTH_CLIENT_SECRET="fixturelog-client-secret-from-auth-server"

# Local/E2E only. Never enable in production (synthetic auth bypass).
E2E_TEST_USER="false"

# LiveKit (voice token-mint route) - server-side only, set the same values in Vercel
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
