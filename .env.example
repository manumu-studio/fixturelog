# FixtureLog environment variables
# Copy to .env and fill in values

# Neon Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Production app URL — used by server components to build absolute fetch URLs to API routes.
# In production this MUST be the deployed origin (e.g. https://fixturelog.vercel.app);
# locally it can be omitted (falls back to http://localhost:3000).
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
