# FixtureLog voice worker credentials. Copy to .env (gitignored) and fill in.
# Keys live ONLY on the worker. Never in the client bundle, never committed.

# --- TASK-101 (transport proof) needs ONLY these three ---
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- TASK-102+ (Deepgram -> Claude -> Cartesia pipeline brain) ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ANTHROPIC_API_KEY=
