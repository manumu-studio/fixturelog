# FixtureLog voice worker credentials. Copy to .env (gitignored) and fill in.
# Keys live ONLY on the worker. Never in the client bundle, never committed.

# Brain selector: "echo" | "pipeline" | "realtime".
#   echo     - transport-only loopback (LiveKit trio alone, no AI providers).
#   pipeline - default; Deepgram STT -> Claude -> Cartesia TTS cascade.
#   realtime - OpenAI speech-to-speech realtime model (Deepgram STT for the turn model).
VOICE_BRAIN=pipeline

# --- LiveKit transport (the echo brain needs ONLY these three) ---
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Pipeline brain (Deepgram -> Claude -> Cartesia) ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ANTHROPIC_API_KEY=

# --- Realtime brain (OpenAI) --- needed ONLY for VOICE_BRAIN=realtime.
# OPENAI_API_KEY=
