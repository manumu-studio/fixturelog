# FixtureLog voice worker credentials. Copy to .env (gitignored) and fill in.
# Keys live ONLY on the worker. Never in the client bundle, never committed.

# Brain selector: "echo" | "pipeline" | "realtime".
#   echo     - transport-only loopback (LiveKit trio alone, no AI providers).
#   pipeline - default; Deepgram STT -> Claude -> ElevenLabs TTS cascade.
#   realtime - OpenAI speech-to-speech realtime model (Deepgram STT for the turn model).
VOICE_BRAIN=pipeline

# --- LiveKit transport (the echo brain needs ONLY these three) ---
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Pipeline brain (Deepgram -> Claude -> ElevenLabs) ---
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
# Optional ElevenLabs voice tuning (sensible defaults baked into brain.py):
#   ELEVENLABS_VOICE_ID - any voice id from your ElevenLabs library (default: premade "Daniel").
#   ELEVENLABS_MODEL    - eleven_turbo_v2_5 (default), eleven_flash_v2_5 (lower latency), etc.
# ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# --- Realtime brain (OpenAI) --- needed ONLY for VOICE_BRAIN=realtime.
# OPENAI_API_KEY=
