// prisma/schema.prisma — FixtureLog data model (SPEC-001 §2–§3)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums (§2) ──────────────────────────────────────────────

enum FixtureStatus {
  DRAFT
  NEGOTIATING
  ON_SUBS
  FIXED
  COMPLETED
  FAILED
}

enum RequirementStatus {
  ENQUIRY
  SHORTLISTED
  NEGOTIATING
  ON_SUBS
  FIXED
  LOST
}

enum VesselStatus {
  OPEN
  ON_HIRE
  YARD
  LAID_UP
}

enum PositionSource {
  SEEDED
  MANUAL
  AIS
  IMPORTED
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

enum VesselType {
  PSV
  AHTS
  MPSV
  CSV
  ERRV
  DSV
  CTV
  SOV
  OTHER
}

enum DPClass {
  DP1
  DP2
  DP3
  NONE
}

enum WorkscopeCode {
  SUPPLY
  ANCHOR_HANDLING
  RIG_MOVE
  TOWING
  CONSTRUCTION
  IMR
  ROV_SUPPORT
  STANDBY
  WIND_OM
}

enum RegionCode {
  NORTH_SEA
  BRAZIL
  US_GULF
  WEST_AFRICA
  MIDDLE_EAST
  SE_ASIA
  MEDITERRANEAN
}

enum Currency {
  GBP
  USD
  NOK
}

enum CharterType {
  SPOT
  TERM
}

enum CharterPartyForm {
  SUPPLYTIME_2017
  OTHER
}

enum SubjectItemStatus {
  PENDING
  LIFTED
  WAIVED
  FAILED
}

enum ScreeningStatus {
  CLEAR
  REVIEW
  BLOCKED
}

enum ScreeningSubjectType {
  VESSEL
  OWNER
  OPERATOR
  CHARTERER
}

enum ScreeningReviewAction {
  REVIEWED
  ESCALATED
  CANNOT_PROCEED
  REVIEW_CLEARED
}

// Honesty label for a vessel's displayed image (§ PACKET-009 honesty rule).
enum VesselImageSource {
  STOCK // generic licensed photo chosen by vessel type
  OPERATOR // owner/operator press/media image
  WIKIMEDIA // Creative Commons image
  EXTERNAL // other licensed source
}

// Discriminates an authenticated identity's audience and home route.
enum AppRole {
  BROKER
  CLIENT
}

// ─── Reference / Party Entities ──────────────────────────────

model Owner {
  id                          String           @id @default(cuid())
  name                        String
  country                     String?
  notes                       String?
  latestScreeningStatus       ScreeningStatus?
  latestScreeningResultId     String?
  latestScreenedAt            DateTime?
  latestScreeningTtlExpiresAt DateTime?
  latestScreeningSourceName   String?
  latestScreeningListName     String?
  latestScreeningListVersion  String?
  latestScreeningListDate     DateTime?
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt

  vessels          Vessel[]
  screeningResults ScreeningResult[]
}

model Charterer {
  id                          String           @id @default(cuid())
  name                        String
  sector                      String?
  contactName                 String?
  contactEmail                String?
  contactPhone                String?
  notes                       String?
  latestScreeningStatus       ScreeningStatus?
  latestScreeningResultId     String?
  latestScreenedAt            DateTime?
  latestScreeningTtlExpiresAt DateTime?
  latestScreeningSourceName   String?
  latestScreeningListName     String?
  latestScreeningListVersion  String?
  latestScreeningListDate     DateTime?
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt

  requirements     Requirement[]
  fixtures         Fixture[]
  appUsers         AppUser[]
  screeningResults ScreeningResult[]
}

model Operator {
  id                          String           @id @default(cuid())
  name                        String
  country                     String?
  notes                       String?
  latestScreeningStatus       ScreeningStatus?
  latestScreeningResultId     String?
  latestScreenedAt            DateTime?
  latestScreeningTtlExpiresAt DateTime?
  latestScreeningSourceName   String?
  latestScreeningListName     String?
  latestScreeningListVersion  String?
  latestScreeningListDate     DateTime?
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt

  vessels          Vessel[]
  fixtures         Fixture[]
  screeningResults ScreeningResult[]
}

model Broker {
  id        String   @id @default(cuid())
  name      String
  office    String?
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fixtures         Fixture[]
  approvedRecaps   Recap[]
  appUsers         AppUser[]
  screeningReviews ScreeningReview[]
}

// Maps an OIDC identity (stable `sub` = externalId) to a business actor: a Broker
// (role BROKER) or a Charterer (role CLIENT). `role` drives the post-login home route
// and data scope. An actor may have multiple auth identities; seeded actors can exist
// without one.
model AppUser {
  id          String   @id @default(cuid())
  externalId  String   @unique
  email       String?
  name        String?
  brokerId    String?
  role        AppRole  @default(BROKER)
  chartererId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  broker    Broker?    @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  charterer Charterer? @relation(fields: [chartererId], references: [id], onDelete: SetNull)

  @@index([brokerId])
  @@index([chartererId])
}

model Region {
  id        String     @id @default(cuid())
  code      RegionCode @unique
  name      String
  centerLat Float
  centerLng Float
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  vessels      Vessel[]        @relation("VesselOpenRegion")
  requirements Requirement[]
  fixtures     Fixture[]
  benchmarks   RateBenchmark[]
}

model Workscope {
  id          String        @id @default(cuid())
  code        WorkscopeCode @unique
  name        String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  requirements Requirement[]
  fixtures     Fixture[]
  benchmarks   RateBenchmark[]
}

model RateBenchmark {
  id          String     @id @default(cuid())
  regionId    String
  vesselType  VesselType
  workscopeId String?
  basisDate   DateTime
  minRate     Float
  medianRate  Float
  maxRate     Float
  source      String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  region    Region     @relation(fields: [regionId], references: [id], onDelete: Restrict)
  workscope Workscope? @relation(fields: [workscopeId], references: [id], onDelete: Restrict)
}

// ─── Core Operational Entities ───────────────────────────────

model Vessel {
  id                          String            @id @default(cuid())
  name                        String
  imo                         String?           @unique
  mmsi                        String?           @unique
  flagState                   String?
  vesselType                  VesselType
  ownerId                     String
  operatorId                  String?
  deckAreaM2                  Float?
  bollardPullT                Float?
  dpClass                     DPClass
  builtYear                   Int?
  status                      VesselStatus
  openRegionId                String?
  openPort                    String?
  openDate                    DateTime?
  imageUrl                    String?
  images                      String[]          @default([])
  imageSource                 VesselImageSource @default(STOCK)
  imageCredit                 String?
  latestScreeningStatus       ScreeningStatus?
  latestScreeningResultId     String?
  latestScreenedAt            DateTime?
  latestScreeningTtlExpiresAt DateTime?
  latestScreeningSourceName   String?
  latestScreeningListName     String?
  latestScreeningListVersion  String?
  latestScreeningListDate     DateTime?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  owner      Owner     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  operator   Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  openRegion Region?   @relation("VesselOpenRegion", fields: [openRegionId], references: [id], onDelete: Restrict)

  positions        PositionSnapshot[]
  fixtures         Fixture[]
  screeningResults ScreeningResult[]

  @@index([status, openRegionId, openDate])
  @@index([operatorId])
}

model PositionSnapshot {
  id               String          @id @default(cuid())
  vesselId         String
  capturedAt       DateTime
  lat              Float
  lng              Float
  portName         String?
  availabilityFrom DateTime?
  source           PositionSource
  confidence       ConfidenceLevel
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  vessel Vessel @relation(fields: [vesselId], references: [id], onDelete: Cascade)
}

model Requirement {
  id               String            @id @default(cuid())
  chartererId      String
  regionId         String
  workscopeId      String
  vesselTypeNeeded VesselType
  minDeckAreaM2    Float?
  minBollardPullT  Float?
  minDpClass       DPClass?
  startDate        DateTime
  endDate          DateTime?
  durationDays     Int?
  charterType      CharterType
  dayRateBudget    Float?
  status           RequirementStatus
  sourceChannel    String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  charterer Charterer @relation(fields: [chartererId], references: [id], onDelete: Restrict)
  region    Region    @relation(fields: [regionId], references: [id], onDelete: Restrict)
  workscope Workscope @relation(fields: [workscopeId], references: [id], onDelete: Restrict)

  fixtures         Fixture[]
  screeningResults ScreeningResult[]
}

model Fixture {
  id                String           @id @default(cuid())
  requirementId     String?
  vesselId          String
  chartererId       String
  brokerId          String
  operatorId        String?
  regionId          String
  workscopeId       String
  charterType       CharterType
  status            FixtureStatus
  agreedDayRate     Float
  currency          Currency
  mobilizationFee   Float?
  demobilizationFee Float?
  durationDays      Int?
  deliveryPort      String?
  redeliveryPort    String?
  commencement      DateTime?
  charterPartyForm  CharterPartyForm
  subjectsSummary   String?
  fixedAt           DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  vessel      Vessel       @relation(fields: [vesselId], references: [id], onDelete: Restrict)
  charterer   Charterer    @relation(fields: [chartererId], references: [id], onDelete: Restrict)
  broker      Broker       @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  operator    Operator?    @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  region      Region       @relation(fields: [regionId], references: [id], onDelete: Restrict)
  workscope   Workscope    @relation(fields: [workscopeId], references: [id], onDelete: Restrict)

  subjects         SubjectItem[]
  recaps           Recap[]
  weatherSnapshots WeatherSnapshot[]
  statusChanges    FixtureStatusChange[]
  screeningResults ScreeningResult[]

  @@index([regionId, fixedAt])
  @@index([operatorId])
}

model SubjectItem {
  id        String            @id @default(cuid())
  fixtureId String
  label     String
  status    SubjectItemStatus @default(PENDING)
  dueAt     DateTime?
  owner     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  fixture Fixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
}

model FixtureStatusChange {
  id         String        @id @default(cuid())
  fixtureId  String
  fromStatus FixtureStatus
  toStatus   FixtureStatus
  actor      String
  notes      String?
  createdAt  DateTime      @default(now())

  fixture Fixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  @@index([fixtureId, createdAt])
}

model ScreeningResult {
  id                 String               @id @default(cuid())
  subjectType        ScreeningSubjectType
  status             ScreeningStatus
  query              String
  sourceName         String
  sourceJurisdiction String?
  sourceListName     String
  sourceListVersion  String
  sourceListDate     DateTime?
  sourceRecordId     String?
  sourceRecordUrl    String?
  matchedName        String?
  matchedIdentifier  String?
  matchType          String
  score              Float?
  reason             String
  screenedAt         DateTime
  ttlExpiresAt       DateTime
  evidence           Json
  fixtureId          String?
  requirementId      String?
  vesselId           String?
  ownerId            String?
  operatorId         String?
  chartererId        String?
  createdAt          DateTime             @default(now())

  fixture     Fixture?          @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  requirement Requirement?      @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  vessel      Vessel?           @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  owner       Owner?            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  operator    Operator?         @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  charterer   Charterer?        @relation(fields: [chartererId], references: [id], onDelete: Cascade)
  reviews     ScreeningReview[]

  @@index([subjectType, status])
  @@index([fixtureId, createdAt])
  @@index([requirementId, createdAt])
  @@index([vesselId, screenedAt])
  @@index([ownerId, screenedAt])
  @@index([operatorId, screenedAt])
  @@index([chartererId, screenedAt])
}

model ScreeningReview {
  id                String                @id @default(cuid())
  screeningResultId String
  brokerId          String
  action            ScreeningReviewAction
  rationale         String
  notes             String?
  createdAt         DateTime              @default(now())

  screeningResult ScreeningResult @relation(fields: [screeningResultId], references: [id], onDelete: Cascade)
  broker          Broker          @relation(fields: [brokerId], references: [id], onDelete: Restrict)

  @@index([screeningResultId, createdAt])
  @@index([brokerId, createdAt])
}

model Recap {
  id                 String    @id @default(cuid())
  fixtureId          String
  version            Int       @default(1)
  generatedMarkdown  String
  generatedText      String
  mainTerms          Json
  approvedByBrokerId String?
  sentAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  fixture          Fixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  approvedByBroker Broker? @relation(fields: [approvedByBrokerId], references: [id], onDelete: Restrict)
}

model WeatherSnapshot {
  id                 String    @id @default(cuid())
  fixtureId          String?
  lat                Float
  lng                Float
  waveHeightM        Float
  swellHeightM       Float?
  windWaveHeightM    Float?
  workabilityVerdict String
  laycanFrom         DateTime?
  laycanTo           DateTime?
  fetchedAt          DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  fixture Fixture? @relation(fields: [fixtureId], references: [id], onDelete: Restrict)
}
