{
  "name": "fixturelog",
  "version": "1.4.0",
  "private": true,
  "description": "Offshore shipbroking workflow — enquiry to fixture to recap",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --turbopack",
    "dev:e2e": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "npx prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "make-broker": "npx tsx scripts/make-broker.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.84",
    "@ai-sdk/react": "^3.0.207",
    "@livekit/components-react": "^2.9.21",
    "@livekit/components-styles": "^1.2.0",
    "@prisma/client": "^6",
    "ai": "^6.0.205",
    "leaflet": "^1.9.4",
    "livekit-client": "^2.19.2",
    "livekit-server-sdk": "^2.15.4",
    "motion": "^12.40.0",
    "next": "^15",
    "next-auth": "^5.0.0-beta.30",
    "react": "^19",
    "react-dom": "^19",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "zod": "^3"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "^8.5.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-v8": "^3",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "prisma": "^6",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
